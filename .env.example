# NEXT_PUBLIC_SITE_URL: Canonical public origin for the site, no trailing slash.
# Drives canonical tags, Open Graph URLs, sitemap.xml, robots.txt and JSON-LD @ids.
# Set this in Vercel -> Project Settings -> Environment Variables once the real
# domain is connected. If unset, the code falls back to Vercel's
# VERCEL_PROJECT_PRODUCTION_URL, then to http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL="https://minihighlandcow.com.au"

# --- Reply portal (app/api/contact/route.ts) ---
# Sends every contact / order / enquiry form through Zoho SMTP. Without
# these set, the API returns a clear 503 rather than a fake "success".
#
# ZOHO_SMTP_USER is the mailbox address (info@minihighlandcow.com.au).
# ZOHO_SMTP_PASS must be a Zoho *app-specific password*
#   (Zoho Mail -> Settings -> Security -> App Passwords), NOT the account
#   login password. Generate it in Zoho, then paste it directly into
#   Vercel's environment variable UI — never into chat, a file, or any
#   other tool.
# ZOHO_SMTP_HOST defaults to smtp.zoho.com; only override if your Zoho
#   account was provisioned on a different data center (smtp.zoho.eu,
#   smtp.zoho.in, smtp.zoho.com.au, etc — check Zoho Mail's own IMAP/POP
#   settings page if unsure).
ZOHO_SMTP_HOST="smtp.zoho.com"
ZOHO_SMTP_PORT="465"
ZOHO_SMTP_USER="info@minihighlandcow.com.au"
ZOHO_SMTP_PASS="MY_ZOHO_APP_PASSWORD"

# GEMINI_API_KEY: Required only if server-side Gemini calls are reintroduced.
# Nothing in the current codebase reads this — it is a leftover from the
# Google AI Studio export.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
