# NEXT_PUBLIC_SITE_URL: Canonical public origin for the site, no trailing slash.
# Drives canonical tags, Open Graph URLs, sitemap.xml, robots.txt and JSON-LD @ids.
# Set this in Vercel -> Project Settings -> Environment Variables once the real
# domain is connected. If unset, the code falls back to Vercel's
# VERCEL_PROJECT_PRODUCTION_URL, then to http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL="https://minihighlandcow.com.au"

# --- Reply portal (app/api/contact/route.ts) ---
# Sends every contact / order / enquiry form through Zoho SMTP. Without
# these set, the API returns a clear 503 rather than a fake "success".
#
# ZOHO_SMTP_USER is the mailbox address (info@minihighlandcow.com.au).
# ZOHO_SMTP_PASS must be a Zoho *app-specific password*
#   (Zoho Mail -> Settings -> Security -> App Passwords), NOT the account
#   login password. Generate it in Zoho, then paste it directly into
#   Vercel's environment variable UI — never into chat, a file, or any
#   other tool.
# ZOHO_SMTP_HOST defaults to smtp.zoho.com; only override if your Zoho
#   account was provisioned on a different data center (smtp.zoho.eu,
#   smtp.zoho.in, smtp.zoho.com.au, etc — check Zoho Mail's own IMAP/POP
#   settings page if unsure).
ZOHO_SMTP_HOST="smtp.zoho.com"
ZOHO_SMTP_PORT="465"
ZOHO_SMTP_USER="info@minihighlandcow.com.au"
ZOHO_SMTP_PASS="MY_ZOHO_APP_PASSWORD"

# GEMINI_API_KEY: Required only if server-side Gemini calls are reintroduced.
# Nothing in the current codebase reads this — it is a leftover from the
# Google AI Studio export.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- Order / admin / invoice / payment pipeline ---
# (lib/orders.ts, lib/admin-auth.ts, lib/db.ts, app/admin/**, app/pay/**)

# Any random string, 32+ characters. Signs every order token (the links in
# order emails) and the admin login cookie. Generate once, paste into
# Vercel, never invent a short/weak value — this is what stops an order
# link from being forged or edited.
ORDER_SIGNING_SECRET="MY_RANDOM_32_PLUS_CHAR_SECRET"

# The passphrase that gates /admin. 8+ characters. Chosen by the business
# owner, pasted directly into Vercel — never typed or relayed by an agent.
ADMIN_PASSPHRASE="MY_ADMIN_PASSPHRASE"

# Vercel Postgres (lib/db.ts) — auto-populated once a Postgres database is
# attached to this project in the Vercel dashboard (Storage tab). Mirrors
# every order purely so the admin portal has something to list; nothing
# here grants access to an order — the signed token in the URL does that.
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=
# (and the other POSTGRES_* / DATABASE_* vars Vercel adds automatically)

# Optional: pre-fills the bank fields in the settlement terminal so the
# admin doesn't retype them for every order. Still editable per-order.
# BANK_ACCOUNT_NAME=
# BANK_BSB=
# BANK_ACCOUNT_NUMBER=
# BANK_PAYID=

# Real crypto wallet addresses are NOT an env var — they go into
# lib/site-config.ts (CRYPTO.wallets), reviewable in a diff. Until real
# addresses are added there, the crypto payment option stays hidden in the
# settlement terminal and the client pay page.
